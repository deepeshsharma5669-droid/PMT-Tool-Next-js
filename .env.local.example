# Postgres connection string (Supabase Session Pooler), used only by local
# inspection/migration scripts — not read by the Next.js app itself.
DATABASE_URL=

# Public Supabase project config, read by the Next.js app (browser + server).
# The anon key is safe to expose — it's already public in public/pmt-legacy.html.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
